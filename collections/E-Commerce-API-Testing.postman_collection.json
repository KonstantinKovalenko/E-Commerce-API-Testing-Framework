          "name": "Cycle",
          "item": [
            {
              "name": "405: Verify Login with not allowed method",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const methods = [\"GET\", \"PUT\", \"PATCH\", \"DELETE\"];",
                      "",
                      "let currentIndex = Number(pm.environment.get(\"runtime_methodIndex\") || 0);",
                      "pm.environment.set(\"RUNTIME_METHOD\", methods[currentIndex]);",
                      "",
                      "pm.environment.set(\"runtime_expectedStatusCode\",200);",
                      "pm.environment.set(\"runtime_expectedResponseCode\",405);",
                      "pm.environment.set(\"runtime_expectedMessageKeyword\", \"not supported\");"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const methods = [\"GET\", \"PUT\", \"PATCH\", \"DELETE\"];",
                      "let currentIndex = Number(pm.environment.get(\"runtime_methodIndex\") || 0);",
                      "currentIndex++;",
                      "",
                      "if (currentIndex < methods.length) {",
                      "    pm.environment.set(\"runtime_methodIndex\", currentIndex);",
                      "    pm.execution.setNextRequest(pm.info.requestName);",
                      "} else {",
                      "    pm.execution.setNextRequest(\"200: Destructive cleanup\");",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "{{RUNTIME_METHOD}}",
                "header": [],
                "url": {
                  "raw": "{{cfg_baseUrl}}/verifyLogin",
                  "host": ["{{cfg_baseUrl}}"],
                  "path": ["verifyLogin"]
                },
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    { "key": "email", "value": "{{runtime_userEmail}}", "type": "text", "disabled": true },
                    { "key": "password", "value": "{{runtime_userPassword}}", "type": "text", "disabled": true }
                  ]
                }
              }
            },
            {
              "name": "200: Destructive cleanup",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const keysArray = Object.keys(pm.environment.toObject());",
                      "keysArray.forEach(key => {",
                      "    if(key.startsWith(\"runtime_\") || key.startsWith(\"RUNTIME_\")){",
                      "        pm.environment.unset(key);",
                      "    }",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{cfg_baseUrl}}/verifyLogin",
                  "host": ["{{cfg_baseUrl}}"],
                  "path": ["verifyLogin"]
                }
              }
            }
          ]
        }
