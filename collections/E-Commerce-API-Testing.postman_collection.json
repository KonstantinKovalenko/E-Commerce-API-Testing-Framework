  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(!pm.environment.get(\"runtime_userName\")){",
          "    const currentDate = Date.now();",
          "    const random = Math.floor(Math.random() * 100);",
          "",
          "    pm.environment.set(\"runtime_expectedStatusCode\", 200);",
          "    pm.environment.set(\"runtime_expectedResponseCode\", 200);",
          "    pm.environment.set(\"runtime_expectedMessageKeyword\", \"keyword\");",
          "",
          "    pm.environment.set(\"runtime_userName\", `user_${currentDate}`);",
          "    pm.environment.set(\"runtime_userEmail\", `email_${currentDate}@qa.com`);",
          "    pm.environment.set(\"runtime_userPassword\", `Qa!${currentDate}${random}`);",
          "    pm.environment.set(\"runtime_userTitle\", `title_${currentDate}`);",
          "    pm.environment.set(\"runtime_userBDay\", \"20\");",
          "    pm.environment.set(\"runtime_userBMonth\", \"10\");",
          "    pm.environment.set(\"runtime_userBYear\", \"2000\");",
          "    pm.environment.set(\"runtime_userFirst\", `first_${currentDate}`);",
          "    pm.environment.set(\"runtime_userLast\", `last_${currentDate}`);",
          "    pm.environment.set(\"runtime_userCompany\", `company_${currentDate}`);",
          "    pm.environment.set(\"runtime_userAdd1\", `address1_${currentDate}`);",
          "    pm.environment.set(\"runtime_userAdd2\", `address2_${currentDate}`);",
          "    pm.environment.set(\"runtime_userCountry\", `country_${currentDate}`);",
          "    pm.environment.set(\"runtime_userState\", `state_${currentDate}`);",
          "    pm.environment.set(\"runtime_userCity\", `city_${currentDate}`);",
          "    pm.environment.set(\"runtime_userZip\", `zip_${currentDate}`);",
          "    pm.environment.set(\"runtime_userMobile\", `mob_${currentDate}`);",
          "",
          "    pm.environment.set(\"runtime_userInvalidEmail\", `${currentDate}`);",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const jsonResponse = pm.response.json();",
          "",
          "const ignoredAllRequests = [",
          "    \"400: Update account using invalid data\",",
          "    \"200: Smoke cleanup\",",
          "    \"200: Cleanup runtime variables\",",
          "    \"200: Negative cleanup\",",
          "    \"200: Destructive cleanup\"",
          "];",
          "",
          "const ignoredMessageRequests = [",
          "    \"200: Get user details\",",
          "];",
          "",
          "if(!ignoredAllRequests.includes(pm.info.requestName)){",
          "    pm.test(`Status code is ${pm.variables.get(\"runtime_expectedStatusCode\")}`, () => {",
          "        pm.response.to.have.status(Number(pm.variables.get(\"runtime_expectedStatusCode\")));",
          "    });",
          "",
          "    pm.test(`Response code is ${pm.variables.get(\"runtime_expectedResponseCode\")}`, () => {",
          "        pm.expect(jsonResponse.responseCode)",
          "            .to.eql(Number(pm.variables.get(\"runtime_expectedResponseCode\")));",
          "    });",
          "",
          "    if (!ignoredMessageRequests.includes(pm.info.requestName)) {",
          "        pm.test(`Response message contains keyword: ${pm.variables.get(\"runtime_expectedMessageKeyword\")}`, () => {",
          "            pm.expect(jsonResponse.message).to.contain(pm.environment.get(\"runtime_expectedMessageKeyword\"));",
          "        });",
          "    }",
          "}",
          "",
          "pm.test(`Response time is less than ${pm.environment.get(\"cfg_maxResponseTime\")} ms`, () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get(\"cfg_maxResponseTime\")));",
          "});"
        ]
      }
    }
  ],
