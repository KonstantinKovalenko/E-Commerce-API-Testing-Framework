                  "",
                  "const fields = {",
                  "    id: \"number\",",
                  "    name: \"string\",",
                  "    email: \"string\",",
                  "    title: \"string\",",
                  "    birth_day: \"string\",",
                  "    birth_month: \"string\",",
                  "    birth_year: \"string\",",
                  "    first_name: \"string\",",
                  "    last_name: \"string\",",
                  "    company: \"string\",",
                  "    address1: \"string\",",
                  "    address2: \"string\",",
                  "    country: \"string\",",
                  "    state: \"string\",",
                  "    city: \"string\",",
                  "    zipcode: \"string\"",
                  "};",
                  "",
                  "pm.test(\"User fields validation\", () => {",
                  "    Object.keys(fields).forEach(field => {",
                  "        pm.expect(user).to.have.property(field);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"User data type validation\", () => {",
                  "    Object.entries(fields).forEach(([field, expectedType]) => {",
                  "        pm.expect(user[field]).to.be.a(expectedType);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"User data matches environment variables\", () => {",
                  "    pm.expect(user.id).to.be.greaterThan(0);",
                  "    pm.expect(user.name).to.eql(pm.environment.get(\"runtime_userName\"));",
                  "    pm.expect(user.email).to.eql(pm.environment.get(\"runtime_userEmail\"));",
                  "    pm.expect(user.title).to.eql(pm.environment.get(\"runtime_userTitle\"));",
