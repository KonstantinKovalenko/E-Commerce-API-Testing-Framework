        {
          "name": "200: Get user details",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"runtime_expectedStatusCode\",200);",
                  "pm.environment.set(\"runtime_expectedResponseCode\",200);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonResponse = pm.response.json()",
                  "const user = jsonResponse.user;",
                  "",
                  "const fields = {",
                  "    id: \"number\",",
                  "    name: \"string\",",
                  "    email: \"string\",",
                  "    title: \"string\",",
                  "    birth_day: \"number\",",
                  "    birth_month: \"number\",",
                  "    birth_year: \"number\",",
                  "    first_name: \"string\",",
                  "    last_name: \"string\",",
                  "    company: \"string\",",
                  "    address1: \"string\",",
                  "    address2: \"string\",",
                  "    country: \"string\",",
                  "    state: \"string\",",
                  "    city: \"string\",",
                  "    zipcode: \"string\"",
                  "};",
                  "",
                  "pm.test(\"User fields validation\", () => {",
                  "    Object.keys(fields).forEach(field => {",
                  "        pm.expect(user).to.have.property(field);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"User data type validation\", () => {",
                  "    Object.entries(fields).forEach(([field, expectedType]) => {",
                  "        pm.expect(user[field]).to.be.a(expectedType);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"User data matches environment variables\", () => {",
                  "    pm.expect(user.id).to.be.greaterThan(0);",
                  "    pm.expect(user.name).to.eql(pm.environment.get(\"runtime_userName\"));",
                  "    pm.expect(user.email).to.eql(pm.environment.get(\"runtime_userEmail\"));",
                  "    pm.expect(user.title).to.eql(pm.environment.get(\"runtime_userTitle\"));",
                  "    pm.expect(user.birth_day).to.eql(pm.environment.get(\"runtime_userBDay\"));",
                  "    pm.expect(user.birth_month).to.eql(pm.environment.get(\"runtime_userBMonth\"));",
                  "    pm.expect(user.birth_year).to.eql(pm.environment.get(\"runtime_userBYear\"));",
                  "    pm.expect(user.first_name).to.eql(pm.environment.get(\"runtime_userFirst\"));",
                  "    pm.expect(user.last_name).to.eql(pm.environment.get(\"runtime_userLast\"));",
                  "    pm.expect(user.company).to.eql(pm.environment.get(\"runtime_userCompany\"));",
                  "    pm.expect(user.address1).to.eql(pm.environment.get(\"runtime_userAdd1\"));",
                  "    pm.expect(user.address2).to.eql(pm.environment.get(\"runtime_userAdd2\"));",
                  "    pm.expect(user.country).to.eql(pm.environment.get(\"runtime_userCountry\"));",
                  "    pm.expect(user.state).to.eql(pm.environment.get(\"runtime_userState\"));",
                  "    pm.expect(user.city).to.eql(pm.environment.get(\"runtime_userCity\"));",
                  "    pm.expect(user.zipcode).to.eql(pm.environment.get(\"runtime_userZip\"));",
                  "});"
                ]
              }
            }
          ],
